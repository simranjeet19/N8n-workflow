    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  let raw =\n    item.json.content?.parts?.[0]?.text ??\n    item.json.text ??\n    item.json.output ??\n    item.json.response ??\n    \"\";\n\n  if (!raw) {\n    throw new Error(\"No Gemini text found.\");\n  }\n\n  raw = String(raw)\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(raw);\n  } catch (error) {\n    throw new Error(\"Gemini output is not valid JSON. Raw output: \" + raw);\n  }\n\n  const jobData = $node[\"Prepare Job Data\"].json;\n  const copiedCv = $node[\"Copy CV Template\"].json;\n\n  return {\n    json: {\n      ...jobData,\n\n      sapExperience: parsed.sapExperience || \"\",\n      glsExperience: parsed.glsExperience || \"\",\n      coverLetter: parsed.coverLetter || \"\",\n\n      cvDocumentId: copiedCv.id,\n      cvDocumentName: copiedCv.name,\n      cvDocLink: `https://docs.google.com/document/d/${copiedCv.id}/edit`\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -176
      ],
      "id": "",
      "name": "Parse Gemini CV Sections"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const job = item.json;\n\n  const title = job.title || \"Unknown Role\";\n\n  const company =\n    job.company ||\n    job.companyName ||\n    job.employerName ||\n    job.source ||\n    \"Unknown Company\";\n\n  const location =\n    job.location?.formattedAddressShort ||\n    job.location?.formattedAddressLong ||\n    job.location?.city ||\n    job.location ||\n    \"\";\n\n  const jobUrl = job.jobUrl || job.url || job.link || \"\";\n\n  const description =\n    job.descriptionText ||\n    job.description ||\n    job.descriptionHtml ||\n    \"\";\n\n  const jobType = Array.isArray(job.jobType)\n    ? job.jobType.join(\", \")\n    : job.jobType || \"\";\n\n  const safeCompany = company\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .slice(0, 35);\n\n  const safeTitle = title\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .slice(0, 45);\n\n  return {\n    json: {\n      ...job,\n\n      title,\n      company,\n      location,\n      jobType,\n      jobUrl,\n      description,\n\n      safeCompany,\n      safeTitle,\n\n      cvFileName: `SimranjeetCV_${safeCompany}_${safeTitle}`,\n      coverLetterFileName: `SimranjeetCoverLetter_${safeCompany}_${safeTitle}`,\n\n      cvDocLink: \"\",\n      coverLetterDocLink: \"\",\n      status: \"Generated\",\n      notes: \"\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        -176
      ],
      "id": "",
      "name": "Prepare Job Data"
