      "parameters": {
        "jsCode": "const job = $node[\"Parse Gemini CV Sections\"].json;\n\nconst cvDocumentId = job.cvDocumentId;\nconst coverLetterDocumentId = $node[\"Copy Cover Letter Template\"].json.id;\n\nreturn [\n  {\n    json: {\n      Title: job.title,\n      Company: job.company,\n      Location: job.location,\n      \"Job Type\": job.jobType,\n      Platform: \"Indeed\",\n      Link: job.jobUrl,\n\n      \"CV Doc Link\": `https://docs.google.com/document/d/${cvDocumentId}/edit`,\n      \"Cover Letter Doc Link\": `https://docs.google.com/document/d/${coverLetterDocumentId}/edit`,\n\n      Date: new Date().toISOString().slice(0, 10),\n\n      \"Fit Score\": \"\",\n      Recommendation: \"\",\n      Category: \"\",\n      \"Matched Skills\": Array.isArray(job.attributes) ? job.attributes.join(\", \") : \"\",\n      \"Red Flags\": \"\",\n      \"German Requirement\": job.language === \"de\" ? \"German job post\" : \"\",\n      \"Years Required\": \"\",\n\n      \"Cover Letter\": job.coverLetter,\n      Status: \"Generated\",\n      Notes: \"\",\n\n      ageDays: job.age || \"\",\n      isTooOld: \"\",\n      fitExplanation: \"\",\n      cleanedJobTextPreview: job.description ? job.description.slice(0, 500) : \"\"\n    }\n  }\n];"
      },
